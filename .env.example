# ---------------------------------------------------------------
# Yayasan Kasih Ananda Web Portal — example environment file
#
# Copy to .env and adjust. NEVER commit the real .env file.
#
#   cp .env.example .env
# ---------------------------------------------------------------

# --- Project ---
COMPOSE_PROJECT_NAME=yka

# --- Database (development container only) ---
DB_NAME=yka_wordpress
DB_USER=yka
DB_PASSWORD=change-me-locally
DB_ROOT_PASSWORD=change-me-locally-root
DB_HOST=db
DB_TABLE_PREFIX=wp_

# --- Host ports (change if already occupied) ---
WP_PORT=8080
PMA_PORT=8081
MAILPIT_UI_PORT=8025

# --- WordPress core ---
# Version extracted into ./wp. If wordpress-<version>.zip is not present in
# the repository root, scripts/extract-core.sh downloads it from
# wordpress.org. Core is never committed.
WP_VERSION=7.1

# --- WordPress site bootstrap values ---
# WP_HOME/WP_SITEURL are auto-detected for Codespaces by scripts/bootstrap.sh.
# Leave blank to auto-detect, or set explicitly for a fixed local setup.
WP_HOME=
WP_SITEURL=
WP_TITLE="Yayasan Kasih Ananda"
WP_LOCALE=id_ID
WP_TIMEZONE=Asia/Jakarta

# --- Administrator account created during bootstrap ---
WP_ADMIN_USER=ykaananda
WP_ADMIN_PASSWORD=change-me-locally
WP_ADMIN_EMAIL=admin@example.test

# --- Environment type: local | development | staging | production ---
# Controls the YKA Core environment guard and admin-bar badge.
WP_ENVIRONMENT_TYPE=local

# --- Debugging ---
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

# --- Optional: extra plugins to install during bootstrap (slugs, space separated) ---
# Rank Math SEO + WPvivid are installed by default; add more here if needed.
WP_EXTRA_PLUGINS=
