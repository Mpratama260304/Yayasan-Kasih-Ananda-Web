{
	"name": "yka-portal",
	"version": "1.0.0",
	"private": true,
	"description": "Development tooling for the Yayasan Kasih Ananda web portal. Node is used for tests and tooling only — the production site runs on plain PHP/MySQL WordPress hosting with no Node runtime.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"test": "playwright test --project=desktop --project=mobile",
		"test:admin": "playwright test --project=admin",
		"test:headed": "playwright test --headed",
		"test:report": "playwright show-report tests/playwright-report",
		"shots": "playwright test --project=screenshots",
		"install:browsers": "playwright install --with-deps chromium"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.0"
	},
	"engines": {
		"node": ">=20"
	}
}
